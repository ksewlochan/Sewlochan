views:
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.ctime
      - file.mtime
      - last_updated_at
      - parent
      - title
    sort:
      - property: file.name
        direction: ASC
      - property: last_updated_at
        direction: DESC
